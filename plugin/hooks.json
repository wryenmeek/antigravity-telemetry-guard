{
  "antigravity-telemetry-hook": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "antigravity-telemetry hook-pre-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "antigravity-telemetry hook-post-tool",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
